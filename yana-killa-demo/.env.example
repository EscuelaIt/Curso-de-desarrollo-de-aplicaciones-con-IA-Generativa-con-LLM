# LLM configuration — demo defaults to DeepSeek Chat (V3)
LLM_MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=sk-xxx

# Comma-separated list of models shown in the top-bar LLMSelector
LLM_MODELS=deepseek/deepseek-chat,deepseek/deepseek-reasoner,claude-sonnet-4-6,azure/gpt-4o,ollama/llama-3.3-70b

# Optional providers — fill what you need
ANTHROPIC_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=
GEMINI_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# Paths
DATA_DIR=./data
DOCS_SEED_DIR=./docs-piloto

# API
API_HOST=0.0.0.0
API_PORT=8000

# Web
VITE_API_URL=http://localhost:8000

# --- Piloto remoto ---
# Si PILOT_TOKEN está vacío, la auth se desactiva (modo dev local).
# Para exponer el demo a un cliente, poner un token largo y aleatorio:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
PILOT_TOKEN=

# Dominios adicionales permitidos en CORS (localhost:* siempre se permite).
# Ejemplo: ALLOWED_ORIGINS=https://yanakilla.example.com
ALLOWED_ORIGINS=

# Rate limits por IP (por hora). 0 desactiva.
RATE_LIMIT_CHAT_PER_HOUR=120
RATE_LIMIT_INGEST_PER_HOUR=30

# Tamaño máximo de PDFs cargados (MB).
MAX_UPLOAD_MB=50
