# Infrastructure configuration for Yana Killa demo
# Copia este archivo a infra/config.env y completa los valores.
# infra/config.env está gitignored.

# ===== AWS =====
REGION="us-east-1"
VPC_ID=""   # ID de la default VPC en tu cuenta AWS

# ===== Dominio (Cloudflare DNS, SSL via origin certs propios) =====
PROD_FQDN="yanakilla.example.com"

# ===== Deploy targets (autocompletados por setup-prod.sh) =====
PROD_SSH_KEY="./yanakilla-prod-key.pem"
PROD_SSH_HOST=""
